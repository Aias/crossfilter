{
  "name": "crossfilter2",
  "version": "1.5.4",
  "description": "Fast multidimensional filtering for coordinated views.",
  "license": "Apache-2.0",
  "keywords": [
    "analytics",
    "visualization",
    "crossfilter"
  ],
  "author": {
    "name": "Mike Bostock",
    "url": "http://bost.ocks.org/mike"
  },
  "contributors": [
    {
      "name": "Jason Davies",
      "url": "http://www.jasondavies.com/"
    }
  ],
  "maintainers": [
    {
      "name": "Gordon Woodhull",
      "url": "https://github.com/gordonwoodhull"
    },
    {
      "name": "Tanner Linsley",
      "url": "https://github.com/tannerlinsley"
    },
    {
      "name": "Ethan Jewett",
      "url": "https://github.com/esjewett"
    }
  ],
  "homepage": "https://crossfilter.github.io/crossfilter/",
  "main": "./crossfilter.cjs",
  "module": "main.js",
  "types": "./lib/index.d.ts",
  "unpkg": "./crossfilter.min.js",
  "repository": {
    "type": "git",
    "url": "http://github.com/crossfilter/crossfilter.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "oxlint": "~1.81.0",
    "rollup": "^2.78.1",
    "rollup-plugin-json": "4",
    "rollup-plugin-terser": "^7.0.2",
    "semver": "^5.7.0",
    "sinon": "^7.5.0",
    "typescript": "~7.0.2",
    "vitest": "^0.22.1"
  },
  "scripts": {
    "benchmark": "node test/benchmark.js",
    "build": "pnpm run clean && tsc && rollup -c rollup.config.js",
    "clean": "rm -rf lib crossfilter.cjs crossfilter.js crossfilter.min.js main.js",
    "demo": "pnpm run build && pnpm --filter crossfilter-demo dev",
    "lint": "oxlint --deny-warnings src index.ts type-tests demo/src rollup.config.js",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run && pnpm run typecheck && pnpm --filter crossfilter-demo check && pnpm run lint",
    "typecheck": "tsc -p tsconfig.types.json --noEmit"
  },
  "files": [
    "NOTICE",
    "crossfilter.cjs",
    "crossfilter.js",
    "crossfilter.min.js",
    "index.d.cts",
    "index.ts",
    "lib",
    "main.js",
    "src"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./main.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./crossfilter.cjs"
      }
    }
  }
}
